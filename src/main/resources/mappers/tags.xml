<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.swdl.sprint2.repository.TagsRepository">
    <select id="CountTagByTagType" resultType="java.lang.Integer" parameterType="java.lang.Integer">
        select COUNT(tag_number) tagCount FROM tags
        <where>
            <if test="tagType != null">
                tag_type = #{tagType.code}
            </if>
        </where>
    </select>

    <select id="getTags" resultType="kr.swdl.sprint2.vo.Tag">
        SELECT tag_number, status, tag_name, contents, tag_type, color, festival_count FROM tags
        <where>
        <if test="query.filterByStatus != null">
            AND status = #{query.filterByStatus}
        </if>
        <choose>
            <when test="query.searchBy == 'tagName'">AND tag_name LIKE CONCAT('%', #{query.keyword}, '%')</when>
        </choose>
        </where>
    </select>
</mapper>